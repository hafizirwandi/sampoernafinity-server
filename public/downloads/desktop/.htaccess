# Desktop release folder. latest.yml is what the app's auto-updater polls,
# so it must never be served stale; installers are versioned by filename and
# can be cached freely.
<IfModule mod_headers.c>
    <FilesMatch "\.yml$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(exe|blockmap)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
    AddType text/yaml .yml
    AddType application/octet-stream .exe .blockmap
</IfModule>

Options -Indexes
